    <script>
      // Função para atualizar o estado synced no Alpine
      const updateSyncedState = (value: boolean) => {
        // Tentar múltiplas vezes até o Alpine estar pronto
        const tryUpdate = (attempts = 0) => {
          const mainElement = document.querySelector("main[x-data]");
          const Alpine = (window as any).Alpine;

          if (mainElement && Alpine) {
            try {
              const alpineData = Alpine.$data(mainElement);
              if (alpineData) {
                alpineData.synced = value;
                return true;
              }
            } catch (e) {
              console.error("Error updating Alpine state:", e);
            }
          }

          // Se não conseguiu e ainda não tentou muitas vezes, tentar novamente
          if (attempts < 10) {
            setTimeout(() => tryUpdate(attempts + 1), 100);
          }
          return false;
        };

        tryUpdate();
      };

      // Verificar localStorage - fonte principal de verdade
      const checkLocalStorageAuth = () => {
        try {
          const hasLocalStorageAuth =
            localStorage.getItem("youtube_auth_synced") === "true";
          if (hasLocalStorageAuth) {
            updateSyncedState(true);
            return true;
          }
        } catch (e) {
          console.error("Error reading localStorage:", e);
        }
        return false;
      };

      // Verificar token no banco de dados via API (fallback/validação)
      const checkTokenInDatabase = async () => {
        try {
          const response = await fetch("/api/auth/check");
          const data = await response.json();

          if (data.hasToken) {
            // Se há token no banco, garantir que está no localStorage
            localStorage.setItem("youtube_auth_synced", "true");
            updateSyncedState(true);
          } else {
            // Se não há token no banco, limpar localStorage
            localStorage.removeItem("youtube_auth_synced");
            updateSyncedState(false);
          }
        } catch (error) {
          console.error("Error checking token:", error);
          // Em caso de erro, confiar no localStorage
          checkLocalStorageAuth();
        }
      };

      // Inicializar verificação quando o Alpine estiver pronto
      const initAuthCheck = () => {
        // Primeiro verifica localStorage (resposta instantânea)
        const hasLocalStorage = checkLocalStorageAuth();

        // Depois verifica o banco de dados para sincronizar (opcional)
        // Só verifica se não encontrou no localStorage ou após um delay
        if (!hasLocalStorage) {
          setTimeout(checkTokenInDatabase, 300);
        } else {
          // Mesmo se encontrou no localStorage, validar com o banco depois
          setTimeout(checkTokenInDatabase, 500);
        }
      };

      // Aguardar Alpine estar pronto
      const waitForAlpine = () => {
        if ((window as any).Alpine) {
          initAuthCheck();
        } else {
          setTimeout(waitForAlpine, 50);
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", waitForAlpine);
      } else {
        waitForAlpine();
      }

      // Verificar resposta da API e atualizar synced se necessário
      document.body.addEventListener("htmx:afterSwap", (event: any) => {
        console.log("asdasdasd");
        if (event.detail?.target?.id === "video-feed") {
          const content = event.detail.target.innerHTML;

          // Verificar se a resposta é "Sem vídeos no Watch Later"
          const isEmptyMessage = content.includes("Sem vídeos no Watch Later");

          // Verificar se há cards de vídeos válidos
          const hasVideoCards =
            content.includes("cursor-pointer") &&
            content.includes("youtube.com/watch");

          const mainElement = document.querySelector("main[x-data]");
          if (mainElement && (window as any).Alpine) {
            const alpineData = (window as any).Alpine.$data(mainElement);
            if (alpineData) {
              if (isEmptyMessage || !hasVideoCards) {
                // Se não houver vídeos ou for mensagem de vazio, definir synced como false
                alpineData.synced = false;
                // Remover flag do localStorage
                localStorage.removeItem("youtube_auth_synced");
              } else {
                // Se houver vídeos, garantir que a flag está salva
                alpineData.synced = true;
                localStorage.setItem("youtube_auth_synced", "true");
              }
            }
          }
        }
      });
    </script>
    <script type="module" src={youtubeSyncScript}></script>
  </body>
</html>
