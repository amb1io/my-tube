---
import '../styles/global.css';
import youtubeSyncScript from '../scripts/youtube-sync.ts?url';

const SELECT_TOKEN_SQL = 'SELECT 1 FROM youtube_tokens WHERE id = ? LIMIT 1';
const getDatabase = (locals: any) => locals?.runtime?.env?.DB;

const database = getDatabase(Astro.locals);
let hasStoredToken = false;
if (database) {
	try {
		const tokenRecord = await database.prepare(SELECT_TOKEN_SQL).bind('youtube').first();
		hasStoredToken = Boolean(tokenRecord);
	} catch {
		// Ignore missing table or other read errors before the first sync completes.
	}
}

const requestUrl = new URL(Astro.request.url);
const syncedFromParam = requestUrl.searchParams.has('synced');
const synced = syncedFromParam || hasStoredToken;

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>My Tube • Dashboard</title>
	</head>
<body class="min-h-screen bg-slate-900 text-white">
		<div class="flex min-h-screen flex-col">
			<header class="sticky top-0 z-30 border-b border-slate-800 bg-slate-950/95 shadow-[0_10px_30px_rgba(0,0,0,0.4)] backdrop-blur">
				<div class="flex items-center justify-between px-6 py-3">
					<div class="flex items-center gap-3 text-2xl font-semibold tracking-tight text-white">
						<div class="h-8 w-8 rounded-sm bg-red-600"></div>
						My Tube
					</div>
					<form class="flex flex-1 items-center justify-center px-6">
						<div class="relative w-full max-w-3xl">
							<input
								class="w-full rounded-full border border-slate-700 bg-slate-900/60 px-4 py-2 pr-28 text-sm text-slate-200 outline-none transition focus:border-white"
								type="search"
								placeholder="Pesquisar vídeos, canais ou tópicos"
							/>
							<button
								type="submit"
								class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white px-4 py-1 text-xs font-semibold uppercase tracking-[0.4em] text-slate-900 transition hover:bg-slate-200"
							>
								Buscar
							</button>
						</div>
					</form>
					<div class="flex items-center gap-4 text-sm text-slate-200">
						<button
							class="rounded-full border border-slate-700/80 px-3 py-1 transition hover:border-white"
							type="button"
							aria-label="Notificações"
						>
							<svg class="h-5 w-5 fill-current text-slate-200" viewBox="0 0 24 24">
								<path d="M12 3a4 4 0 0 0-4 4v3.586L6.293 14.293a1 1 0 0 0-.293.707V17h14v-2a1 1 0 0 0-.293-.707L16 10.586V7a4 4 0 0 0-4-4zM8 17h8v-1H8z"/>
							</svg>
						</button>
						<div class="flex items-center gap-2 rounded-full border border-slate-700/80 px-3 py-1">
							<div class="h-8 w-8 rounded-full bg-gradient-to-br from-rose-500 via-orange-500 to-yellow-500"></div>
							<span class="text-xs uppercase tracking-[0.3em] text-slate-300">RH</span>
						</div>
					</div>
				</div>
			</header>

			<section class="flex flex-1 overflow-hidden">
				<aside class="hidden w-72 flex-col border-r border-slate-800 bg-slate-950 p-6 text-sm shadow-[0_30px_60px_rgba(0,0,0,0.5)] lg:flex">
					<div class="mb-6 flex items-center justify-between text-xs font-semibold uppercase tracking-[0.6em] text-slate-500">
						<span>Menu</span>
						<span>LIVE</span>
					</div>
					<nav class="flex-1 space-y-2 text-slate-300">
						<a class="flex items-center gap-3 rounded-full px-3 py-2 transition hover:bg-slate-800" href="#">
							<svg class="h-5 w-5 fill-current text-slate-400" viewBox="0 0 24 24"><path d="M10 17h4v-6h4l-6-7-6 7h4z"/></svg>
							<span>Início</span>
						</a>
						<a class="flex items-center gap-3 rounded-full px-3 py-2 transition hover:bg-slate-800" href="#">
							<svg class="h-5 w-5 fill-current text-slate-400" viewBox="0 0 24 24"><path d="M13 6.5V4l-6 6v7h14v-7z"/></svg>
							<span>Em alta</span>
						</a>
						<a class="flex items-center gap-3 rounded-full px-3 py-2 transition hover:bg-slate-800" href="#">
							<svg class="h-5 w-5 fill-current text-slate-400" viewBox="0 0 24 24"><path d="M5 4v16l14-8z"/></svg>
							<span>Shorts</span>
						</a>
						<a class="flex items-center gap-3 rounded-full px-3 py-2 transition hover:bg-slate-800" href="#">
							<svg class="h-5 w-5 fill-current text-slate-400" viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/></svg>
							<span>Inscrições</span>
						</a>
						<div class="mt-4 border-t border-slate-800 pt-4 text-xs uppercase tracking-[0.3em] text-slate-500">
							Biblioteca
						</div>
						<a class="flex items-center gap-3 rounded-full px-3 py-2 transition hover:bg-slate-800" href="#">
							<svg class="h-5 w-5 fill-current text-slate-400" viewBox="0 0 24 24"><path d="M5 3h14v2H5zm0 4h10v2H5zm0 4h14v2H5zm0 4h10v2H5zm0 4h14v2H5z"/></svg>
							<span>Histórico</span>
						</a>
						<a class="flex items-center gap-3 rounded-full px-3 py-2 transition hover:bg-slate-800" href="#">
							<svg class="h-5 w-5 fill-current text-slate-400" viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 4 2 7-6-4-6 4 2-7L2 9h7z"/></svg>
							<span>Favoritos</span>
						</a>
						<a class="flex items-center gap-3 rounded-full px-3 py-2 transition hover:bg-slate-800" href="#">
							<svg class="h-5 w-5 fill-current text-slate-400" viewBox="0 0 24 24"><path d="M12 5v6h4v2H8v-2h4V5zM5 17h14v2H5z"/></svg>
							<span>Downloads</span>
						</a>
					</nav>
					<div class="mt-6 text-xs text-slate-500">Suas playlists recentes aparecem aqui.</div>
				</aside>

				<main class="flex-1 overflow-y-auto px-6 py-6">
					<div class="mb-6 rounded-3xl border border-white/5 bg-gradient-to-br from-slate-900/80 to-slate-800/70 p-6 shadow-[0_25px_60px_rgba(0,0,0,0.45)]">
						<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
							<div>
								<p class="text-sm uppercase tracking-[0.4em] text-slate-400">Sincronizar</p>
								<h1 class="text-3xl font-semibold text-white">Use sua conta do YouTube</h1>
							</div>
							<button
								id="youtube-sync"
								class="rounded-full bg-red-600 px-6 py-2 text-sm font-semibold uppercase tracking-[0.3em] text-white transition hover:bg-red-500"
								type="button"
							>
								Sincronize aqui
							</button>
						</div>
						<p class="mt-3 text-sm text-slate-300" id="youtube-sync-status" aria-live="polite">
							Abra a janela de autenticação para conectar o YouTube Data e começar a trazer vídeos e playlists.
						</p>
					</div>

						<div class="space-y-2" x-data={`{ synced: ${synced} }`}>
						<div class="flex items-center justify-between">
							<div>
								<p class="text-xs uppercase tracking-[0.4em] text-slate-500">Para você</p>
								<h2 class="text-xl font-semibold text-white">Assistir agora</h2>
							</div>
							<button
								class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400 transition hover:text-white"
								type="button"
								x-show="synced"
							>
								Ver tudo
							</button>
						</div>

						<div x-show="!synced">
							<div class="mt-6 rounded-3xl border border-dashed border-slate-700 bg-slate-900/70 p-8 text-center text-sm text-slate-400 shadow-[0_20px_40px_rgba(0,0,0,0.35)]">
								<p class="text-white">Conecte sua conta do YouTube para liberar a grade de vídeos recomendados.</p>
								<p class="mt-2 text-xs uppercase tracking-[0.4em] text-slate-500">
									A sincronização libera playlists, shorts e recomendações personalizadas.
								</p>
							</div>
						</div>

						<div
							id="video-feed"
							class="mt-4"
							x-show="synced"
							hx-get="/api/watch-later"
							x-bind:hx-trigger="synced ? 'load' : 'none'"
							hx-target="this"
							hx-swap="innerHTML"
						>
							<div class="flex min-h-[200px] items-center justify-center rounded-3xl border border-slate-800 bg-slate-900/70 text-sm text-slate-400">
								<span>Carregando seus vídeos do Watch Later…</span>
							</div>
						</div>
					</div>
				</main>
			</section>
		</div>
		<script type="module" src={youtubeSyncScript}></script>
</body>
</html>
